# ServiceBridge API — copy to .env and fill in. Never commit .env.

NODE_ENV=development          # development | test | production
APP_ENV=development           # development | staging | production
PORT=4000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ServiceBridge's own Postgres database (not the ERP's).
# docker-compose default: postgresql://servicebridge:servicebridge@localhost:5433/servicebridge
DATABASE_URL=postgresql://servicebridge:servicebridge@localhost:5432/servicebridge

# docker-compose default: redis://localhost:6380
REDIS_URL=redis://localhost:6379

# Encrypts ERP and SMTP credentials stored in the database. REQUIRED.
# Format: v1:<base64 of 32 random bytes>. Generate with: openssl rand -base64 32
# To rotate, put the new key first and keep the old one: v2:<new>,v1:<old>
# Losing every key means stored credentials must be re-entered in the admin UI.
APP_ENCRYPTION_KEYS=

# Public address of the web app (no trailing slash). Used in invite and reset
# links. When it starts with https://, auth cookies are marked Secure.
APP_URL=http://localhost:3000

# Signs sign-in tokens. REQUIRED, at least 32 characters.
# Generate with: openssl rand -base64 48
# Changing it signs everyone out (they sign in again; nothing else is lost).
JWT_SECRET=

# Optional (defaults shown): access token life, idle sign-out, hard session limit.
# ACCESS_TOKEN_TTL_SECONDS=900
# SESSION_IDLE_DAYS=14
# SESSION_MAX_DAYS=30

# Integration tests only: a separate, migrated database that the tests EMPTY.
# TEST_DATABASE_URL=postgresql://servicebridge:servicebridge@localhost:5432/servicebridge_test

# Refuse ERP connections to private/loopback addresses (protects against SSRF).
# Set to true only when your ERPNext runs on your own network (e.g. local Docker).
# ALLOW_PRIVATE_ERP_HOSTS=false

# Address ERPNext uses to reach ServiceBridge webhooks (defaults to APP_URL).
# A cloud ERP cannot reach localhost: use a tunnel URL here when testing locally.
# PUBLIC_WEBHOOK_BASE_URL=https://your-tunnel.example.com
