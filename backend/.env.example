# ServiceBridge API — copy to .env and fill in. Never commit .env.

NODE_ENV=development          # development | test | production
APP_ENV=development           # development | staging | production
PORT=4000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ServiceBridge's own Postgres database (not the ERP's).
# docker-compose default: postgresql://servicebridge:servicebridge@localhost:5433/servicebridge
DATABASE_URL=postgresql://servicebridge:servicebridge@localhost:5432/servicebridge

# docker-compose default: redis://localhost:6380
REDIS_URL=redis://localhost:6379

# Encrypts ERP and SMTP credentials stored in the database. REQUIRED.
# Format: v1:<base64 of 32 random bytes>. Generate with: openssl rand -base64 32
# To rotate, put the new key first and keep the old one: v2:<new>,v1:<old>
# Losing every key means stored credentials must be re-entered in the admin UI.
APP_ENCRYPTION_KEYS=
