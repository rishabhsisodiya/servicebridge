{
  "name": "servicebridge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ServiceBridge API (NestJS)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev --name schema_update",
    "prisma:deploy": "prisma migrate deploy",
    "admin:create": "ts-node -P tsconfig.json src/cli/create-admin.ts",
    "admin:create:prod": "node dist/cli/create-admin.js",
    "test:int": "jest --config test/jest-int.json --runInBand",
    "secrets:reencrypt": "ts-node -P tsconfig.json src/cli/reencrypt-secrets.ts",
    "demo:seed": "ts-node -P tsconfig.json src/cli/demo-seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^4.9.0",
    "csv-parse": "^7.0.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.4",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.0.12",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.6",
    "typescript-eslint": "^8.70.1"
  }
}
