// ServiceBridge's own database. Unrelated to any ERP schema.
// Models are added per build session. Create migrations with `npm run migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// App-wide settings as key/value pairs (demo mode, company name, timezone,
/// currency, GST rate, routing mode...). Values are validated in code per key.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── People & access ────────────────────────────────────────────────────────

/// Which tickets people with a role can see.
enum TicketScope {
  ALL
  /// The user's region, plus tickets they manage, raised or work on.
  REGION
  /// Tickets assigned to or raised by the user.
  OWN
}

/// What a user may do. Admins create roles and pick permissions from the
/// catalog in auth/permissions.ts; built-in roles are seeded by migration.
model Role {
  id          String      @id @default(cuid())
  /// Fixed key of a built-in role (e.g. ENGINEER); null for roles admins create.
  key         String?     @unique
  name        String      @unique
  description String?
  /// The Administrator role: every permission, cannot be changed or deleted.
  isLocked    Boolean     @default(false)
  /// Permission names; unknown names are ignored when read.
  permissions String[]
  ticketScope TicketScope
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
  ON_LEAVE
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

/// Service region. Sites are routed to a region by pincode prefix.
model Region {
  id            String       @id @default(cuid())
  name          String       @unique
  /// Receives new tickets for sites in this region.
  areaManagerId String?
  areaManager   User?        @relation("RegionAreaManager", fields: [areaManagerId], references: [id], onDelete: SetNull)
  /// Created by the demo seed; removed by "Clear demo data".
  isDemo        Boolean      @default(false)
  version       Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  users         User[]       @relation("UserRegion")
  rules         RegionRule[]
  tickets       Ticket[]
}

/// A site whose pincode starts with `pincodePrefix` belongs to the region.
/// The longest matching prefix wins, so "5601" overrides "560".
model RegionRule {
  id            String   @id @default(cuid())
  regionId      String
  region        Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  pincodePrefix String   @unique
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([regionId])
}

model User {
  id                String     @id @default(cuid())
  /// Always stored lower-case.
  email             String     @unique
  name              String
  /// E.164 staff mobile, used for WhatsApp notifications.
  phone             String?
  roleId            String
  role              Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status            UserStatus @default(INVITED)
  /// argon2id. Null until the invite is accepted.
  passwordHash      String?
  passwordChangedAt DateTime?
  regionId          String?
  region            Region?    @relation("UserRegion", fields: [regionId], references: [id], onDelete: SetNull)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  /// Optimistic locking: edits must send the version they read.
  version           Int        @default(1)
  /// Created by the demo seed; removed by "Clear demo data".
  isDemo            Boolean    @default(false)
  /// Set by engineers (and managers); "on visit" is derived from their tickets.
  dutyStatus        DutyStatus @default(ON_DUTY)
  dutyChangedAt     DateTime?

  sessions       Session[]
  tokens         UserToken[] @relation("TokenOwner")
  tokensIssued   UserToken[] @relation("TokenIssuer")
  auditEntries   AuditLog[]
  managedRegions Region[]    @relation("RegionAreaManager")
  skills         UserSkill[]

  ticketsAssigned       Ticket[]           @relation("TicketEngineer")
  ticketsManaged        Ticket[]           @relation("TicketAreaManager")
  ticketsLogged         Ticket[]           @relation("TicketCreatedBy")
  partnerApiKeys        PartnerApiKey[]
  ticketEvents          TicketEvent[]
  ticketFiles           TicketAttachment[]
  notifications         Notification[]
  visitsSubmitted       Visit[]            @relation("VisitSubmittedBy")
  visitsCreated         Visit[]            @relation("VisitCreatedBy")
  VisitPhoto            VisitPhoto[]
  quotationsSent        Quotation[]        @relation("QuotationSentBy")
  quotationsCreated     Quotation[]        @relation("QuotationCreatedBy")
  preferredAmcContracts AmcContract[]      @relation("AmcPreferredEngineer")
  amcContractsCreated   AmcContract[]      @relation("AmcContractCreatedBy")
  pushTokens            PushToken[]
  reportSchedules       ReportSchedule[]   @relation("ReportScheduleCreatedBy")
  reportRuns            ReportRun[]        @relation("ReportRunRequestedBy")

  @@index([roleId])
  @@index([status])
  @@index([regionId])
}

/// One row per sign-in. The refresh token rotates in place; the previous hash
/// is kept briefly so two tabs refreshing at once don't look like token theft.
model Session {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the current refresh token (the token itself is never stored).
  tokenHash         String    @unique
  previousTokenHash String?   @unique
  rotatedAt         DateTime?
  /// Sliding expiry, pushed forward on each refresh up to absoluteExpiresAt.
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  /// Last time the user re-entered their password (for sensitive actions).
  stepUpAt          DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  @@index([userId, revokedAt])
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

/// Single-use links for accepting an invite or resetting a password.
model UserToken {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("TokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  type        UserTokenType
  /// sha256 of the token in the link.
  tokenHash   String        @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?         @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([userId, type])
}

/// Append-only record of changes. Secrets are never written here.
model AuditLog {
  id           String         @id @default(cuid())
  /// Null for changes made by the system itself.
  actorId      String?
  actor        User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Dotted verb, e.g. "user.invited", "auth.password_changed".
  action       String
  entityType   String
  entityId     String?
  /// Plain-English line shown in the audit log screen.
  summary      String
  /// Field-level before/after for updates.
  changes      Json?
  ip           String?
  requestId    String?
  /// Partner API key behind this change, if any.
  partnerKeyId String?
  partnerKey   PartnerApiKey? @relation(fields: [partnerKeyId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([partnerKeyId])
}

// ─── ERP connections ────────────────────────────────────────────────────────

enum ErpKind {
  FRAPPE
}

enum ErpConnectionStatus {
  /// Saved but not tested since its URL or credentials last changed.
  UNTESTED
  ACTIVE
  /// Recent calls are failing (e.g. credentials rotated on the ERP side).
  FAILING
  DISABLED
  /// Stored secrets can't be decrypted with the current APP_ENCRYPTION_KEYS.
  KEY_ERROR
}

/// What a connection is used for. Each purpose has at most one connection.
enum ErpPurpose {
  MASTER_SYNC
  WRITEBACK
}

/// An ERPNext site added by an administrator. Secrets are AES-256-GCM
/// encrypted (core/crypto) and never returned by the API.
model ErpConnection {
  id                  String              @id @default(cuid())
  name                String              @unique
  kind                ErpKind             @default(FRAPPE)
  /// Origin only, e.g. https://erp.example.com
  baseUrl             String
  apiKeyEnc           String
  /// Last 4 characters of the API key, so admins can tell keys apart.
  apiKeyHint          String
  apiSecretEnc        String
  /// Optional read-only MariaDB access for heavy dashboard queries.
  dbHost              String?
  dbPort              Int?
  dbName              String?
  dbUser              String?
  dbPasswordEnc       String?
  dbSsl               Boolean             @default(true)
  /// Most queries run at once against the ERP database (connection pool size).
  dbConnectionLimit   Int                 @default(3)
  status              ErpConnectionStatus @default(UNTESTED)
  /// When the URL, credentials or DB settings last changed; a test must be newer to enable.
  detailsChangedAt    DateTime            @default(now())
  erpVersion          String?
  lastTestedAt        DateTime?
  /// Outcome of the last test (no secrets, no business data).
  lastTestResult      Json?
  consecutiveFailures Int                 @default(0)
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  version             Int                 @default(1)

  /// Signs webhooks from ERPNext (HMAC-SHA256). Encrypted; set when webhooks are set up.
  webhookSecretEnc String?

  purposes ErpPurposeBinding[]
  requests ErpRequestLog[]
  webhooks ErpWebhookEvent[]
}

model ErpPurposeBinding {
  purpose      ErpPurpose    @id
  connectionId String
  connection   ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  updatedAt    DateTime      @updatedAt
}

enum ErpChannel {
  REST
  DB
}

/// One attempted ERP write: a draft sales invoice or a stock entry.
/// Retries are idempotent: `idempotencyKey` is unique, and the worker
/// pre-searches the ERP for the key (stamped as `custom_sb_ref`) before
/// creating anything, so a retried job can never duplicate a document.
enum WritebackType {
  INVOICE
  STOCK_ENTRY
}

enum WritebackStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model ErpWriteback {
  id             String          @id @default(cuid())
  type           WritebackType
  status         WritebackStatus @default(PENDING)
  ticketId       String?
  ticket         Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  visitId        String?
  visit          Visit?          @relation(fields: [visitId], references: [id], onDelete: SetNull)
  quotationId    String?
  /// Fixed per source record (e.g. `invoice-<ticketId>`); also stamped on the
  /// ERP document as `custom_sb_ref` for the idempotent pre-search.
  idempotencyKey String          @unique
  erpDocType     String
  /// The ERP document name, once created.
  erpDocName     String?
  attempts       Int             @default(0)
  error          String?         @db.Text
  /// Snapshot of what was (or will be) sent: lines, warehouse, customer.
  payload        Json?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ticketId])
  @@index([status])
}

/// Every call ServiceBridge makes to an ERP, for the System monitor.
/// Request bodies, query parameters and credentials are never stored.
model ErpRequestLog {
  id           String         @id @default(cuid())
  connectionId String?
  connection   ErpConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  channel      ErpChannel
  /// HTTP method, or "SQL".
  method       String
  /// Path without query string, or a short label for SQL ("SELECT tabCustomer").
  target       String
  doctype      String?
  httpStatus   Int?
  ok           Boolean
  latencyMs    Int
  error        String?
  /// Queue job that caused the call, when there is one (session 5).
  jobId        String?
  createdAt    DateTime       @default(now())

  @@index([connectionId, createdAt])
  @@index([ok, createdAt])
}

// ─── Automations & background jobs ──────────────────────────────────────────

/// On/off switch and settings for one automation. Definitions (what each one
/// does, its defaults) live in code: src/automations/definitions.ts.
model AutomationSetting {
  key         String   @id
  enabled     Boolean
  /// Periodic automations only: cron expression in `timezone`.
  cron        String?
  timezone    String   @default("Asia/Kolkata")
  /// Automation-specific options, validated in code.
  params      Json     @default("{}")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum JobTrigger {
  SCHEDULE
  MANUAL
  EVENT
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// History of automation runs shown in the Automations screen. Per-record
/// timers (SLA etc.) are visible in the System monitor instead, to keep this small.
model JobRun {
  id            String       @id @default(cuid())
  automationKey String
  queue         String
  jobId         String?
  trigger       JobTrigger
  actorId       String?
  status        JobRunStatus @default(RUNNING)
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  /// Plain-English outcome, e.g. "Removed 1,204 old request log rows".
  summary       String?
  error         String?

  @@index([automationKey, startedAt])
  @@index([status])
}

// ─── Reports (session 14) ────────────────────────────────────────────────────
// One repeatable BullMQ job per active schedule (fixed id `report-schedule-<id>`);
// the worker re-reads the row and skips inactive/deleted ones. Every schedule is
// its own switch, off by default.

enum ReportTrigger {
  MANUAL
  SCHEDULE
}

enum ReportRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ReportSchedule {
  id          String      @id @default(cuid())
  name        String
  reportKey   String
  params      Json
  cron        String
  timezone    String      @default("Asia/Kolkata")
  /// User ids of recipients; each must have an email address.
  recipients  Json
  active      Boolean     @default(false)
  lastRunAt   DateTime?
  createdById String?
  createdBy   User?       @relation("ReportScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Optimistic locking: edits must send the version they read.
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  runs        ReportRun[]

  @@index([active])
}

model ReportRun {
  id            String          @id @default(cuid())
  scheduleId    String?
  schedule      ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  reportKey     String
  params        Json
  trigger       ReportTrigger
  status        ReportRunStatus @default(RUNNING)
  rowCount      Int             @default(0)
  /// StorageService key of the generated CSV (`reports/<runId>.csv`), if kept.
  csvKey        String?
  error         String?         @db.Text
  requestedById String?
  requestedBy   User?           @relation("ReportRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  @@index([scheduleId, startedAt])
  @@index([status])
}

// ─── Master data mirrored from the ERP ──────────────────────────────────────
// Read-only copies. `source` says where a row came from; ERP rows are keyed by
// (erpConnectionId, erpName). Rows missing from the ERP are marked inactive,
// never deleted, so tickets that reference them keep working.

enum RecordSource {
  DEMO
  ERP
  LOCAL
  IMPORT
}

model Customer {
  id              String            @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  name            String
  customerGroup   String?
  territory       String?
  taxId           String?
  mobile          String?
  email           String?
  /// Opt-out of WhatsApp business-initiated template messages.
  whatsappOptOut  Boolean           @default(false)
  active          Boolean           @default(true)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  contacts        CustomerContact[]
  sites           Site[]
  equipment       Equipment[]

  tickets        Ticket[]
  amcContracts   AmcContract[]
  /// Customer portal sign-ins (magic-link sessions).
  portalSessions CustomerSession[]

  @@unique([erpConnectionId, erpName])
  @@index([name])
}

model CustomerContact {
  id              String       @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// ERP customer name, kept so the link can be made when the customer arrives later.
  customerErpName String?
  fullName        String
  email           String?
  mobile          String?
  phone           String?
  /// Opt-out of WhatsApp business-initiated template messages.
  whatsappOptOut  Boolean      @default(false)
  isPrimary       Boolean      @default(false)
  active          Boolean      @default(true)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tickets        Ticket[]
  portalTokens   CustomerToken[]
  portalSessions CustomerSession[]

  @@unique([erpConnectionId, erpName])
  @@index([customerId])
}

enum CustomerTokenType {
  MAGIC_LINK
}

/// Single-use magic-link tokens for customer portal sign-in. Mirrors
/// UserToken but is bound to a CustomerContact, never a staff User.
model CustomerToken {
  id        String            @id @default(cuid())
  contactId String
  contact   CustomerContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      CustomerTokenType @default(MAGIC_LINK)
  /// sha256 of the token in the link.
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([contactId, type])
}

/// One customer portal sign-in. The session token is sha256-hashed at rest;
/// customerId is denormalized so every request can scope cheaply.
model CustomerSession {
  id                String          @id @default(cuid())
  contactId         String
  contact           CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// sha256 of the session token (the token itself is never stored).
  tokenHash         String          @unique
  /// Sliding expiry, pushed forward on activity up to absoluteExpiresAt.
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  ip                String?
  userAgent         String?
  createdAt         DateTime        @default(now())
  lastUsedAt        DateTime        @default(now())

  @@index([contactId, revokedAt])
  @@index([customerId])
}

/// A customer location, from the ERP's Address.
model Site {
  id              String       @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerErpName String?
  title           String
  line1           String?
  line2           String?
  city            String?
  state           String?
  pincode         String?
  country         String?
  gstin           String?
  active          Boolean      @default(true)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tickets Ticket[]

  @@unique([erpConnectionId, erpName])
  @@index([customerId])
  @@index([pincode])
}

/// A machine at a customer site, from the ERP's Serial No.
model Equipment {
  id                String       @id @default(cuid())
  source            RecordSource
  erpConnectionId   String?
  erpName           String?
  serialNo          String
  itemCode          String?
  itemName          String?
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerErpName   String?
  erpStatus         String?
  warrantyExpiresOn DateTime?    @db.Date
  amcExpiresOn      DateTime?    @db.Date
  active            Boolean      @default(true)
  erpModified       DateTime?
  syncedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tickets          Ticket[]
  amcContractLinks AmcContractEquipment[]
  plannedVisits    AmcPlannedVisit[]

  @@unique([erpConnectionId, erpName])
  @@index([serialNo])
  @@index([customerId])
}

model Item {
  id              String          @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  itemCode        String
  name            String
  itemGroup       String?
  uom             String?
  isStockItem     Boolean         @default(true)
  active          Boolean         @default(true)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  visitSpares     VisitSpare[]
  quotationLines  QuotationLine[]

  @@unique([erpConnectionId, erpName])
  @@index([itemCode])
}

model ItemPrice {
  id              String       @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  itemCode        String
  priceList       String
  rate            Decimal      @db.Decimal(18, 4)
  currency        String
  selling         Boolean      @default(true)
  buying          Boolean      @default(false)
  active          Boolean      @default(true)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([erpConnectionId, erpName])
  @@index([itemCode, priceList])
}

model Warehouse {
  id              String       @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  name            String
  company         String?
  isGroup         Boolean      @default(false)
  active          Boolean      @default(true)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([erpConnectionId, erpName])
}

/// Stock of an item in a warehouse, from the ERP's Bin.
model StockLevel {
  id              String       @id @default(cuid())
  source          RecordSource
  erpConnectionId String?
  erpName         String?
  itemCode        String
  warehouse       String
  actualQty       Decimal      @db.Decimal(18, 4)
  projectedQty    Decimal      @db.Decimal(18, 4)
  erpModified     DateTime?
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([erpConnectionId, erpName])
  @@index([itemCode])
}

/// Where the incremental sync got to, per connection and doctype.
model SyncCursor {
  /// "{connectionId}:{doctype}"
  key          String   @id
  /// ERPNext's own "modified" text (sortable), so no time-zone conversion can skip records.
  lastModified String?
  updatedAt    DateTime @updatedAt
}

enum WebhookEventStatus {
  QUEUED
  PROCESSED
  IGNORED
  REJECTED
  FAILED
}

/// Every webhook ERPNext sent, for the System monitor.
model ErpWebhookEvent {
  id             String             @id @default(cuid())
  connectionId   String?
  connection     ErpConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  doctype        String?
  docName        String?
  event          String?
  /// The ERP record's modified timestamp from the webhook payload. Replays
  /// carry the same value, so it doubles as the idempotency key (SB-H5).
  docModified    String?
  signatureValid Boolean
  status         WebhookEventStatus
  /// Plain-English reason for IGNORED / REJECTED / FAILED.
  detail         String?
  jobId          String?
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?

  @@index([connectionId, receivedAt])
  @@index([status, receivedAt])
}

// ─── Service rules (session 7) ──────────────────────────────────────────────

enum TicketStage {
  NEW
  TRIAGED
  ASSIGNED
  ACCEPTED
  ON_SITE
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  VERIFIED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Coverage {
  AMC
  WARRANTY
  CHARGEABLE
}

enum BillingUnit {
  PER_VISIT
  PER_HOUR
  PER_KM
  FIXED
}

/// Machine skill used to suggest engineers. A machine needs the skill when its
/// model (Equipment.itemCode) is listed in `equipmentModels`.
model SkillTag {
  id              String      @id @default(cuid())
  name            String      @unique
  description     String?
  equipmentModels String[]
  isDemo          Boolean     @default(false)
  version         Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  users           UserSkill[]
}

model UserSkill {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillTagId String
  skillTag   SkillTag @relation(fields: [skillTagId], references: [id], onDelete: Cascade)

  @@id([userId, skillTagId])
  @@index([skillTagId])
}

/// When SLA clocks run. Times are in the company time zone.
model BusinessCalendar {
  id         String      @id @default(cuid())
  name       String      @unique
  /// 24×7: `hours` and `holidays` are ignored.
  alwaysOpen Boolean     @default(false)
  /// [{ day: 0-6 (Sunday = 0), open: "09:00", close: "18:00" }]
  hours      Json        @default("[]")
  /// [{ date: "2026-10-02", name: "Gandhi Jayanti" }]
  holidays   Json        @default("[]")
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  policies   SlaPolicy[]
}

/// Response and resolution targets for one coverage × priority pair (always 12 rows).
model SlaPolicy {
  id                String           @id @default(cuid())
  coverage          Coverage
  priority          TicketPriority
  responseMinutes   Int
  resolutionMinutes Int
  calendarId        String
  calendar          BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  version           Int              @default(1)
  updatedAt         DateTime         @updatedAt

  @@unique([coverage, priority])
}

model ServiceType {
  id                String         @id @default(cuid())
  name              String         @unique
  description       String?
  defaultPriority   TicketPriority @default(MEDIUM)
  /// Whether a ticket of this type must name a machine.
  requiresEquipment Boolean        @default(true)
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tickets           Ticket[]
  amcContracts      AmcContract[]
}

/// Display name and meaning of each fixed priority.
model PriorityLevel {
  priority    TicketPriority @id
  label       String
  description String?
  version     Int            @default(1)
  updatedAt   DateTime       @updatedAt
}

/// Display name of each fixed ticket stage.
model StageLabel {
  stage       TicketStage @id
  label       String
  description String?
  version     Int         @default(1)
  updatedAt   DateTime    @updatedAt
}

/// Service charges billed on chargeable tickets (visit, labour, travel…).
model BillingRate {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  unit        BillingUnit
  amount      Decimal     @db.Decimal(12, 2)
  /// ERP item billed for this charge on the draft invoice (write-back, later).
  erpItemCode String?
  active      Boolean     @default(true)
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── Tickets (session 8) ────────────────────────────────────────────────────

enum TicketChannel {
  PHONE
  EMAIL
  WHATSAPP
  PORTAL
  AMC_VISIT
  PARTNER
}

enum TicketEventType {
  CREATED
  ROUTED
  ASSIGNED
  STAGE_CHANGED
  NOTE
  PRIORITY_CHANGED
  ATTACHMENT
  SLA_AT_RISK
  SLA_BREACHED
  ESCALATED
  REOPENED
  /// Customer approved a quotation via the portal.
  APPROVAL
}

/// Yearly ticket number sequence: SB-26-000123.
model TicketCounter {
  year Int @id
  last Int @default(0)
}

model Ticket {
  id                     String             @id @default(cuid())
  number                 String             @unique
  title                  String
  description            String?
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId                 String?
  site                   Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipmentId            String?
  equipment              Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  contactId              String?
  contact                CustomerContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  serviceTypeId          String
  serviceType            ServiceType        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  priority               TicketPriority
  channel                TicketChannel
  /// Worked out from the machine when the ticket was logged.
  coverage               Coverage
  coverageUntil          DateTime?          @db.Date
  stage                  TicketStage        @default(NEW)
  /// Where ON_HOLD returns to.
  stageBeforeHold        TicketStage?
  holdReason             String?
  regionId               String?
  region                 Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  areaManagerId          String?
  areaManager            User?              @relation("TicketAreaManager", fields: [areaManagerId], references: [id], onDelete: SetNull)
  engineerId             String?
  engineer               User?              @relation("TicketEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  createdById            String?
  createdBy              User?              @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// SLA targets copied from the policy when logged, so later policy edits don't move open tickets.
  responseMinutes        Int
  resolutionMinutes      Int
  slaCalendarId          String?
  responseDueAt          DateTime
  resolutionDueAt        DateTime
  respondedAt            DateTime?
  resolvedAt             DateTime?
  verifiedAt             DateTime?
  closedAt               DateTime?
  cancelledAt            DateTime?
  /// Set while ON_HOLD: open minutes left on each clock when the hold began.
  pausedAt               DateTime?
  responseLeftMin        Int?
  resolutionLeftMin      Int?
  /// The running clock (response until accepted, then resolution). Null while paused or finished.
  slaDueAt               DateTime?
  /// When the running clock turns "at risk" (last 25% of its target).
  slaRiskAt              DateTime?
  responseBreached       Boolean            @default(false)
  resolutionBreached     Boolean            @default(false)
  /// Once a clock has breached it stays breached here, even across reopens —
  /// SLA compliance history is never rewritten.
  responseBreachedEver   Boolean            @default(false)
  resolutionBreachedEver Boolean            @default(false)
  reopenCount            Int                @default(0)
  duplicateOfId          String?
  duplicateOf            Ticket?            @relation("TicketDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates             Ticket[]           @relation("TicketDuplicate")
  /// Partner API key that logged this ticket, if any.
  partnerKeyId           String?
  partnerKey             PartnerApiKey?     @relation(fields: [partnerKeyId], references: [id], onDelete: SetNull)
  /// The partner's own reference — idempotency key, unique per partner key.
  externalRef            String?
  isDemo                 Boolean            @default(false)
  version                Int                @default(1)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  events                 TicketEvent[]
  writebacks             ErpWriteback[]
  attachments            TicketAttachment[]
  notifications          Notification[]
  visits                 Visit[]
  quotations             Quotation[]
  csatTokens             CsatToken[]
  emailLogs              EmailLog[]
  plannedVisits          AmcPlannedVisit[]
  WhatsAppLog            WhatsAppLog[]

  @@unique([partnerKeyId, externalRef])
  @@index([stage, priority])
  @@index([engineerId, stage])
  @@index([areaManagerId, stage])
  @@index([regionId, stage])
  @@index([equipmentId, stage])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([slaRiskAt])
}

model PartnerApiKey {
  id          String    @id @default(cuid())
  name        String
  /// SHA-256 hex of the key. The key itself is never stored.
  keyHash     String    @unique
  /// Non-secret prefix (e.g. "sbp_9f2k…") shown in the UI for identification.
  keyPrefix   String
  /// Permission names granted to this key; validated as a subset of the
  /// creator's own permissions when the key is created.
  scopes      String[]
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tickets   Ticket[]
  auditLogs AuditLog[]

  @@index([createdById])
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      TicketEventType
  /// Null for ServiceBridge itself (routing, SLA timers).
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  fromStage TicketStage?
  toStage   TicketStage?
  note      String?
  data      Json?
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
}

/// Files are on local disk under STORAGE_DIR; `storageKey` is the relative path.
model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

/// A field visit on a ticket. Drafts are editable; submitting locks the visit.
model Visit {
  id               String         @id @default(cuid())
  ticketId         String
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Sequential per ticket: visit 1, 2, …
  visitNumber      Int
  status           VisitStatus    @default(DRAFT)
  /// What was done on site. Required before submitting.
  workDone         String?        @db.Text
  /// Storage key of the signature PNG, or a recorded refusal.
  signatureKey     String?
  signatoryName    String?
  signatureRefused Boolean        @default(false)
  refusalReason    String?
  submittedAt      DateTime?
  submittedById    String?
  submittedBy      User?          @relation("VisitSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?          @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isDemo           Boolean        @default(false)
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  spares           VisitSpare[]
  photos           VisitPhoto[]
  writebacks       ErpWriteback[]

  @@unique([ticketId, visitNumber])
  @@index([ticketId])
}

enum VisitStatus {
  DRAFT
  SUBMITTED
}

/// Spares used on a visit. Whole units only.
model VisitSpare {
  id        String   @id @default(cuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())

  @@index([visitId])
}

/// Photos taken on a visit. Files are on local disk under STORAGE_DIR.
model VisitPhoto {
  id           String   @id @default(cuid())
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([visitId])
}

// ─── Quotations (session 10b) ───────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  PO_RECEIVED
  EXPIRED
  REVISED
  CANCELLED
}

/// A price quote for a chargeable ticket. Drafts are editable; sending locks the
/// quotation and starts its validity clock. A PO, a revision or cancellation
/// supersedes it. Totals are computed, never stored.
model Quotation {
  id                   String          @id @default(cuid())
  ticketId             String
  ticket               Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Yearly sequence: QT-26-000123.
  number               String          @unique
  status               QuotationStatus @default(DRAFT)
  /// Optional total-level discount, in percent (0–100).
  discountPercent      Decimal?        @db.Decimal(5, 2)
  /// The offer lapses after this date; the expiry automation then marks EXPIRED.
  validUntil           DateTime        @db.Date
  notes                String?         @db.Text
  sentAt               DateTime?
  sentById             String?
  sentBy               User?           @relation("QuotationSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  poNumber             String?
  poDate               DateTime?       @db.Date
  poReceivedAt         DateTime?
  /// Set when the customer approves this quotation in the portal. Approval
  /// alone does not move status; a supplied PO number flows through recordPo.
  approvedByCustomerAt DateTime?
  /// The quotation this one revises, when it is a revision.
  revisesId            String?
  revises              Quotation?      @relation("QuotationRevision", fields: [revisesId], references: [id], onDelete: SetNull)
  revisions            Quotation[]     @relation("QuotationRevision")
  createdById          String?
  createdBy            User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isDemo               Boolean         @default(false)
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lines                QuotationLine[]

  @@index([ticketId])
}

/// One priced line on a quotation: an item, a quantity and the quoted rate.
model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// Fractional quantities allowed (e.g. labour hours).
  quantity    Decimal   @db.Decimal(12, 2)
  rate        Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@index([quotationId])
}

/// Yearly quotation number sequence: QT-26-000123.
model QuotationCounter {
  year Int @id
  last Int @default(0)
}

// ─── AMC contracts, feedback, email (session 12) ────────────────────────────

enum AmcContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AmcPlannedVisitStatus {
  PLANNED
  CREATED
  SKIPPED
}

/// An annual maintenance contract covering a customer's machines.
model AmcContract {
  id                  String            @id @default(cuid())
  /// Yearly sequence: AMC-26-000123.
  number              String            @unique
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status              AmcContractStatus @default(DRAFT)
  /// First and last day of cover, inclusive.
  startsOn            DateTime          @db.Date
  endsOn              DateTime          @db.Date
  billingUnit         BillingUnit       @default(FIXED)
  /// Contract value in the company currency.
  value               Decimal?          @db.Decimal(14, 2)
  /// Service type for the PM tickets the scheduler creates.
  serviceTypeId       String?
  serviceType         ServiceType?      @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  notes               String?           @db.Text
  preferredEngineerId String?
  preferredEngineer   User?             @relation("AmcPreferredEngineer", fields: [preferredEngineerId], references: [id], onDelete: SetNull)
  createdById         String?
  createdBy           User?             @relation("AmcContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isDemo              Boolean           @default(false)
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  equipment     AmcContractEquipment[]
  plannedVisits AmcPlannedVisit[]

  @@index([customerId])
  @@index([status])
}

/// One machine covered by one contract.
model AmcContractEquipment {
  contractId  String
  contract    AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@id([contractId, equipmentId])
  @@index([equipmentId])
}

/// One negotiated PM visit on a contract; the scheduler turns it into a ticket.
model AmcPlannedVisit {
  id          String                @id @default(cuid())
  contractId  String
  contract    AmcContract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipmentId String?
  equipment   Equipment?            @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  plannedOn   DateTime              @db.Date
  ticketId    String?
  ticket      Ticket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  status      AmcPlannedVisitStatus @default(PLANNED)
  version     Int                   @default(1)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([contractId])
  @@index([plannedOn])
}

/// Yearly AMC contract number sequence: AMC-26-000123.
model AmcContractCounter {
  year       Int @id
  lastNumber Int @default(0)
}

/// A single-use feedback link for one closed ticket. The raw token is never stored.
model CsatToken {
  id        String        @id @default(cuid())
  /// SHA-256 of the 256-bit token.
  tokenHash String        @unique
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// The public feedback URL, stored so the service team can copy it later.
  url       String?
  /// Survey links expire 90 days after minting; describe()/answer() reject expired tokens.
  expiresAt DateTime?
  /// Whether the invite email was queued.
  emailed   Boolean       @default(false)
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  response  CsatResponse?

  /// One token per ticket: backstops the close-action optimistic lock so a
  /// concurrent double-close can never mint two survey links.
  @@unique([ticketId])
}

/// One customer's answer. One row per token: single-use at the database level.
model CsatResponse {
  id        String    @id @default(cuid())
  tokenId   String    @unique
  token     CsatToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// 1–5 stars.
  rating    Int
  comment   String?   @db.Text
  createdAt DateTime  @default(now())
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// An editable email template. `{{variable}}` placeholders are filled when sending.
model EmailTemplate {
  key       String   @id
  name      String
  subject   String
  bodyHtml  String   @db.Text
  bodyText  String   @db.Text
  enabled   Boolean  @default(true)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Every email the system tried to send; the outbox worker updates the status.
model EmailLog {
  id          String      @id @default(cuid())
  to          String
  templateKey String
  ticketId    String?
  ticket      Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  subject     String
  bodyHtml    String      @db.Text
  bodyText    String      @db.Text
  status      EmailStatus @default(QUEUED)
  error       String?     @db.Text
  attempts    Int         @default(0)
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([ticketId])
}

/// Delivery states for a WhatsApp message, updated by the outbox worker and
/// the provider's delivery-receipt webhook.
enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// A Meta-approved WhatsApp template. Bodies are NOT admin-editable: every
/// business-initiated template must be pre-approved by Meta, so the body lives
/// in seed data with positional {{1}} parameters. Disabled by default — the
/// WhatsApp channel is off everywhere until an admin enables it.
model WhatsAppTemplate {
  key                  String   @id
  name                 String
  /// The template name as approved in the WhatsApp Business account.
  providerTemplateName String
  languageCode         String   @default("en")
  /// Positional parameters {{1}}, {{2}} — filled in order when sending.
  bodyText             String   @db.Text
  enabled              Boolean  @default(false)
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt
}

/// Every WhatsApp message the system tried to send; the outbox worker and the
/// delivery-receipt webhook update the status.
model WhatsAppLog {
  id                String         @id @default(cuid())
  /// E.164 phone number, e.g. +919876543210.
  to                String
  templateKey       String
  ticketId          String?
  ticket            Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  providerMessageId String?
  status            WhatsAppStatus @default(QUEUED)
  error             String?        @db.Text
  attempts          Int            @default(0)
  sentAt            DateTime?
  createdAt         DateTime       @default(now())

  @@index([status])
  @@index([ticketId])
  @@index([providerMessageId])
}

/// A device that may receive push notifications (delivery is a later session).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Notifications (session 9) ──────────────────────────────────────────────

enum NotificationType {
  TICKET_NEW
  TICKET_UNROUTED
  TICKET_ASSIGNED
  TICKET_UNASSIGNED
  TICKET_DECLINED
  TICKET_RESOLVED
  TICKET_SENT_BACK
  SLA_AT_RISK
  SLA_BREACHED
  VISIT_SUBMITTED
  QUOTATION_EXPIRED
  TICKET_ESCALATED
  WRITEBACK_SUCCEEDED
  WRITEBACK_FAILED
  AMC_RENEWAL
}

/// In-app notification (the bell). Email and push reuse these events later.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  ticketId  String?
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}
